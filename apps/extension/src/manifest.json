{
	"manifest_version": 3,
	"name": "nisi",
	"version": "0.1.0",
	"description": "Hands a GitHub pull request page you arrived at directly off to the nisi desktop app.",
	"key": "",
	"permissions": ["webNavigation", "storage"],
	"host_permissions": ["https://github.com/*"],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	}
}
