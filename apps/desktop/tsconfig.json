{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"#/*": ["./src/*"]
		}
	},
	"include": ["src"],
	// `*.test.ts` files use `bun:test`, a Bun-runtime module absent from this
	// config's browser-facing `lib`/`types` (no `@types/bun` here, unlike
	// `tsconfig.sidecar.json`'s explicit `types: ["bun"]`) — `bun test` itself
	// transpiles and runs them without needing `tsc` to type-check first, so
	// excluding them here just keeps this pass scoped to app code, same as
	// sidecar/scripts already get their own tsconfig instead of sharing this one.
	"exclude": ["src/**/*.test.ts"],
	"references": [{ "path": "./tsconfig.node.json" }]
}
