{
	"root": false,
	"extends": ["../../biome.jsonc"],
	"files": {
		"includes": ["!!**/.data", "!**/routeTree.gen.ts"]
	},
	"overrides": [
		{
			// Vendored from the coss ui registry (`shadcn add @coss/...`) — not
			// hand-authored, so a11y nitpicks here just add lint noise on every
			// registry sync.
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off",
						"noStaticElementInteractions": "off",
						"useSemanticElements": "off"
					},
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		},
		{
			// The rule flags any capitalized key holding a function, so Effect's
			// `catchTags` handler maps (keyed by error tag) all trip it. The sidecar
			// has no React.
			"includes": ["sidecar/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noComponentHookFactories": "off"
					}
				}
			}
		}
	]
}
