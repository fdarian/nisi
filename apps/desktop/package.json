{
	"name": "@repo/desktop",
	"private": true,
	"version": "0.6.1",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:vite": "vite",
		"build": "bun run build:sidecar && bun run build:cli && bun run build:frontend && bun run build:electron && electron-builder",
		"build:dev": "rm -f binaries/nisi-cli && bun run build:sidecar && bun run build:frontend:dev && bun run build:electron && electron-builder",
		"build:electron": "bun build electron/main.ts electron/preload.ts --outdir dist-electron --target=node --format=cjs --external electron && echo '{\"type\":\"commonjs\"}' > dist-electron/package.json",
		"build:frontend": "tsr generate && tsc && vite build",
		"build:frontend:dev": "tsr generate && tsc && NODE_ENV=development vite build --minify false --sourcemap",
		"preview": "vite preview",
		"sidecar": "bun run sidecar/index.ts",
		"check:type": "tsr generate && tsrs --noEmit && tsc -b tsconfig.guide-render.json && tsrs --noEmit -p tsconfig.sidecar.json && tsrs --noEmit -p tsconfig.scripts.json && tsrs --noEmit -p tsconfig.electron.json",
		"check:lint": "biome lint .",
		"test": "bun test sidecar electron",
		"db:generate": "bun -b drizzle-kit generate && bun -b deskkit gen-migrations && bunx biome check --write .gen/migrations.gen.ts",
		"db:studio": "bun -b drizzle-kit studio",
		"build:sidecar": "bun scripts/build-guide-css.ts && bun scripts/build-binary.ts sidecar/index.ts binaries/sidecar",
		"build:cli": "bun scripts/build-binary.ts ../../packages/cli/src/index.ts binaries/nisi-cli --bytecode",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
