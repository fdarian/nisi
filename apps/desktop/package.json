{
	"name": "@repo/desktop",
	"private": true,
	"version": "0.3.2",
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:vite": "vite",
		"build": "tauri build --config src-tauri/tauri.build.conf.json",
		"build:dev": "tauri build --config src-tauri/tauri.build.dev.conf.json",
		"build:frontend": "tsr generate && tsc && vite build",
		"build:frontend:dev": "tsr generate && tsc && NODE_ENV=development vite build --minify false --sourcemap",
		"preview": "vite preview",
		"tauri": "tauri",
		"sidecar": "bun run sidecar/index.ts",
		"check:type": "tsr generate && tsc --noEmit && tsc --noEmit -p tsconfig.sidecar.json && tsc --noEmit -p tsconfig.scripts.json",
		"check:lint": "biome lint .",
		"test": "bun test sidecar",
		"build:sidecar": "bun scripts/build-binary.ts sidecar/index.ts src-tauri/binaries/sidecar-aarch64-apple-darwin",
		"build:cli": "bun scripts/build-binary.ts ../../packages/cli/src/index.ts src-tauri/binaries/nisi-cli-aarch64-apple-darwin",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
