{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "nisi",
	"version": "0.3.2",
	"identifier": "com.nisi.desktop",
	"build": {
		"beforeDevCommand": "vite",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build:sidecar && bun run build:frontend",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Nisi",
				"width": 1100,
				"height": 720,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": { "x": 12, "y": 24 }
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
