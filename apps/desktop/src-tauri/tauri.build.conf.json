{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeBuildCommand": "bun run build:sidecar && bun run build:cli && bun run build:lsp && bun run build:frontend"
	},
	"bundle": {
		"externalBin": ["binaries/sidecar", "binaries/nisi-cli"],
		"macOS": {
			"signingIdentity": "-",
			"entitlements": "./entitlements.plist",
			"files": {
				"Resources/ts-lsp": "binaries/ts-lsp"
			}
		}
	}
}
