{
	"extends": "@total-typescript/tsconfig/bundler/no-dom/library-monorepo",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noErrorTruncation": true,
		"types": ["bun"],
		"skipLibCheck": true,
		// `sidecar/guide/tools.ts` server-renders the Guide tab's React kit
		// (`src/features/guide/`), which uses JSX, the DOM lib and the app's `#/` alias.
		"jsx": "react-jsx",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"paths": { "#/*": ["./src/*"] }
	},
	"include": ["sidecar"]
}
