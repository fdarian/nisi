{
	"extends": "@total-typescript/tsconfig/bundler/dom",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noErrorTruncation": true,
		"types": ["bun"],
		"skipLibCheck": true,
		// Electrobun 2.x ships its SDK through Hutch's generated devkit, not node_modules (`electrobun prepare` writes it).
		"paths": {
			"electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
		}
	},
	"include": [
		"electrobun",
		"electrobun.config.ts",
		"hutch.config.ts",
		"src/infra/native.ts"
	]
}
