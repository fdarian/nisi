{
	"name": "@repo/walkthrough",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./db": "./src/db/schema.ts",
		"./db-migrations": "./.gen/migrations.gen.ts"
	},
	"scripts": {
		"check:type": "tsrs --noEmit",
		"check:lint": "biome lint .",
		"test": "bun test",
		"db:generate": "bun -b drizzle-kit generate && bun -b deskkit gen-migrations && bunx biome check --write .gen/migrations.gen.ts",
		"db:studio": "bun -b drizzle-kit studio"
	},
	"dependencies": {
		"@ai-sdk/provider": "4.0.33",
		"@ai-sdk/provider-utils": "5.0.67",
		"@repo/git": "workspace:*",
		"deskkit": "github:fdarian/deskkit",
		"drizzle-orm": "1.0.0-rc.5-5935859",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@total-typescript/tsconfig": "1.0.4",
		"@types/bun": "1.4.3",
		"ai": "7.0.152",
		"drizzle-kit": "1.0.0-rc.5-5935859",
		"tsrs": "catalog:",
		"typescript": "7.0.2"
	}
}
