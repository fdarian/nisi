{
	"name": "@repo/walkthrough",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./db": "./src/db/schema.ts",
		"./db-migrations": "./.gen/migrations.gen.ts"
	},
	"scripts": {
		"check:type": "tsc --noEmit",
		"check:lint": "biome lint .",
		"test": "bun test",
		"db:generate": "bun -b drizzle-kit generate && bun run src/db/gen-migrations.ts",
		"db:studio": "bun -b drizzle-kit studio"
	},
	"dependencies": {
		"@ai-sdk/provider": "4.0.4",
		"@ai-sdk/provider-utils": "5.0.18",
		"@repo/git": "workspace:*",
		"ai": "7.0.48",
		"deskkit": "github:fdarian/deskkit",
		"drizzle-orm": "1.0.0-rc.4",
		"effect": "4.0.0-beta.102"
	},
	"devDependencies": {
		"@total-typescript/tsconfig": "1.0.4",
		"@types/bun": "1.3.14",
		"drizzle-kit": "1.0.0-rc.4",
		"typescript": "7.0.2"
	}
}
