# macOS
.DS_Store

# Local tool state (worktrees, etc.), not project config. `/*` rather than `/` so
# launch.json can be negated below — git can't re-include a file whose parent
# directory is itself excluded.
.claude/*
# Shared: how an agent starts the dev server / storybook under its own process
# management, so it can read the logs. See apps/desktop/AGENTS.md.
!.claude/launch.json
# Shared: this repo's changeset + PR conventions, loaded as a project skill.
!.claude/skills
/.nisi/
# Electrobun shell: Hutch's generated devkit projection and build outputs.
apps/desktop/.hutch
apps/desktop/build-electrobun
apps/desktop/release-electrobun
