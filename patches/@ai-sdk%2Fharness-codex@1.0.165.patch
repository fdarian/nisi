+// nisi patch: upstream resolves these files at runtime through
+// `new URL("./bridge/<name>", import.meta.url)`. Bun's compiler can't see
+// through that, yet `import.meta.url` is still rewritten to a virtual
+// `/$bunfs/...` path inside a `bun build --compile` binary, so the read fails
+// with `ENOENT: /$bunfs/root/bridge/package.json`. Static `with { type: "text" }`
+// imports are inlined as string literals at compile time, so they survive
+// being embedded in nisi's compiled sidecar. See knowledge/compiled-binary-differences.md.
+import bridgePackageJsonText from "./bridge/package.json" with { type: "text" };
+import bridgePnpmLockText from "./bridge/pnpm-lock.yaml" with { type: "text" };
